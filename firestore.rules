rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'linh.persie.10@gmail.com' ||
        request.auth.token.rev_isSuperadmin == true ||
        request.auth.token.superadmin == true ||
        request.auth.token.role == 'superadmin' ||
        request.auth.token.fnb == 1
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/FNB_SURVEY_users/$(request.auth.uid)).data;
    }

    function hasAdminInvite() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/FNB_SURVEY_role_invites/$(request.auth.token.email.lower())) &&
        (
          get(/databases/$(database)/documents/FNB_SURVEY_role_invites/$(request.auth.token.email.lower())).data.role == 'admin' ||
          get(/databases/$(database)/documents/FNB_SURVEY_role_invites/$(request.auth.token.email.lower())).data.role == 'superadmin'
        );
    }

    function isAdminOrSuper() {
      return isSuperAdmin() ||
        (isSignedIn() && (request.auth.token.role == 'admin' || request.auth.token.admin == true)) ||
        (
          isSignedIn() &&
          exists(/databases/$(database)/documents/FNB_SURVEY_users/$(request.auth.uid)) &&
          (getUserData().role == 'superadmin' || getUserData().role == 'admin' || getUserData().isSuperadmin == true)
        ) ||
        hasAdminInvite();
    }

    // Hồ sơ người dùng & phân quyền (Superadmin / Admin / Đáp viên)
    match /FNB_SURVEY_users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdminOrSuper());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdminOrSuper());
      allow delete: if isSuperAdmin();

      // Kho lưu trữ mã PIN 6 số đã băm (PBKDF2-SHA256)
      match /private/{docId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdminOrSuper());
      }
    }

    // Danh sách phân quyền trước theo email (Pre-assigned roles)
    match /FNB_SURVEY_role_invites/{emailId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSuper();
    }

    // Cấu hình hệ thống khảo sát (Câu hỏi, Đáp án, Câu hỏi con, Vị trí, Định dạng dữ liệu)
    match /FNB_SURVEY_config/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete, write: if isAdminOrSuper();
    }

    // Dữ liệu phiếu khảo sát F&B Sun World Ba Na Hills
    match /FNB_SURVEY_responses/{responseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrSuper();
    }

    // Nhật ký kiểm toán
    match /FNB_SURVEY_audit_logs/{logId} {
      allow read: if isAdminOrSuper();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
